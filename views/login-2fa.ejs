<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Two-Factor Verification - Secure Login App</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <h1>Enter your 6-digit code</h1>
    <p class="hint">Open your authenticator app and enter the current code.</p>

    <% if (error) { %>
      <ul class="errors">
        <li><%= error %></li>
      </ul>
    <% } %>

    <form method="POST" action="/login/2fa" novalidate>
      <label>
        Authentication code
        <input type="text" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus>
      </label>
      <button type="submit">Verify</button>
    </form>
  </div>
</body>
</html>
