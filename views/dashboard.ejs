<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Secure Login App</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <h1>Welcome, <%= username %></h1>
    <p>You are logged in. This page is only reachable with a valid session.</p>

    <% if (twofaEnabled) { %>
      <p class="success">Two-factor authentication is <strong>enabled</strong> on your account.</p>
      <form method="POST" action="/2fa/disable">
        <button type="submit" class="secondary">Disable 2FA</button>
      </form>
    <% } else { %>
      <p>Two-factor authentication is <strong>not</strong> enabled.</p>
      <a class="button" href="/2fa/setup">Set up 2FA</a>
    <% } %>

    <form method="POST" action="/logout">
      <button type="submit">Log Out</button>
    </form>
  </div>
</body>
</html>
